#: includes/class-tet-notify-live.php:126
msgid "Play the sound"
msgstr "Αναπαραγωγή ήχου"

#: includes/class-tet-notify-live.php:139 includes/class-tet-notify-settings.php:104
msgid "Settings"
msgstr "Ρυθμίσεις"

#: includes/class-tet-notify-order-data.php:79
msgid "Sample product"
msgstr "Δοκιμαστικό προϊόν"

#: includes/class-tet-notify-order-data.php:80
