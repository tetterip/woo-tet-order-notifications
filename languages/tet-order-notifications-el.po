msgstr "Κλείσιμο όλων"

#: includes/class-tet-notify-live.php:76
msgid "Order alerts: sound on"
msgstr "Ειδοποιήσεις παραγγελιών: ήχος ενεργός"

#: includes/class-tet-notify-live.php:77
